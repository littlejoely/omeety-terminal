{
  "name": "omeety-terminal-host",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Omeety Terminal native messaging host: PTY + browser-control MCP",
  "main": "src/index.js",
  "bin": {
    "omeety": "bin/omeety.js"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-permissions.cjs",
    "package:release": "node scripts/package-release.mjs",
    "test": "npm run test:runtime && npm run test:core && npm run test:replay && npm run test:log && npm run test:download && npm run test:smoke",
    "test:runtime": "node ../_test/extension-runtime-regression.mjs",
    "test:core": "node ../_test/browser-core.mjs",
    "test:replay": "node ../_test/output-replay-buffer.mjs",
    "test:log": "node ../_test/log-rotation.mjs",
    "test:download": "node ../_test/download-manager.mjs",
    "test:smoke": "node ../_test/mock-native.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.0",
    "node-pty": "^1.1.0",
    "undici": "^6.28.0"
  }
}
