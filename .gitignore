# Local secrets and machine-specific configuration
.env
.env.*
!.env.example
*.key
*.pem
tools/omeety-key.pem

# Dependencies and generated bundles/caches
**/node_modules/
**/__pycache__/
*.py[cod]
.pytest_cache/

# Native-host runtime files generated by installer/install.ps1
host/host-manifest.json
host/run-host.bat
host/host-debug.log

# Browser profiles and local diagnostics may contain login state or page data
_pwtest/*
!_pwtest/README.md
!_pwtest/test_cursor_probe.py
!_pwtest/test_cursor_sync_rows.py
!_pwtest/test_cursor_active_codex.py
!_pwtest/test_ime_composition.py
!_pwtest/test_browser_tool_reliability.py

# Logs, screenshots, backups, and editor/OS state
*.log
*.png
!docs/images/omeety-terminal.png
*.jpg
*.jpeg
*.bak
*.bak-*
.vscode/
.idea/
.DS_Store
Thumbs.db
